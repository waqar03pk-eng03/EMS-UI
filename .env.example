# Copy this file to .env (do not commit .env)
PORT=4000
CLIENT_ORIGIN=http://localhost:3001

# Must match the credentials used by docker-compose.yml
MONGO_ROOT_USER=ems_admin
MONGO_ROOT_PASSWORD=ems_password
MONGO_URI=mongodb://ems_admin:ems_password@localhost:27017/ems?authSource=admin

# JWT signing secret: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Booking fee charged when an event is created (payment is simulated for now)
BOOKING_FEE=50
BOOKING_CURRENCY=USD

# Used by "npm run seed" to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator
